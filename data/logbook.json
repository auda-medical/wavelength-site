  "pathways": [
    {
      "id": "rcem", "label": "RCEM", "name": "Royal College of Emergency Medicine PoCUS",
      "source": "RCEM PoCUS curriculum (2021 curriculum, Appendix 3). Indicative minimum scans and reflective notes. Sign-off is by DOPS.",
      "checked": "2026-10-04",
      "windowFrom": null,
      "modules": [
        { "id": "rcem-aaa", "label": "AAA", "types": ["aaa"], "total": 25, "reflections": 5 },
        { "id": "rcem-efast", "label": "eFAST or FAFF", "types": ["efast"], "total": 25, "reflections": 5 },
        { "id": "rcem-els", "label": "Echo in life support", "types": ["els"], "total": 10, "reflections": 5 },
        { "id": "rcem-shock", "label": "Shock assessment", "types": ["shock"], "total": 25, "reflections": 5 },
        { "id": "rcem-va", "label": "Vascular access", "types": ["cvc", "picc", "pva"], "total": 5, "reflections": 5 },
        { "id": "rcem-fib", "label": "Fascia iliaca block", "types": ["fib"], "total": 10, "reflections": 5 }
      ]
    },
    {
      "id": "famus", "label": "FAMUS", "name": "Focused Acute Medicine Ultrasound (Society for Acute Medicine)",
      "source": "FAMUS curriculum packs: Thoracic (v1, 2023), DVT (v1.1, 2025), Peripheral access (v1.3), Ultrasound-assisted LP (v1.4), Abdominal-renal (v2.0). Training completes within 2 years of the first supervised scan.",
      "checked": "2026-10-04",
      "windowFrom": "firstSupervised", "windowDays": 730,
      "modules": [
        { "id": "famus-thoracic", "label": "Thoracic", "types": ["lung"], "total": 40, "supervised": 10, "minDays": 183, "rules": [
          { "label": "Consolidation", "min": 5, "match": { "f.consolidation": ["Yes"] } },
          { "label": "Increased lung water", "min": 5, "match": { "f.blines": ["Diffuse"] } },
          { "label": "Pleural effusion", "min": 20, "match": { "f.effusion": ["Small", "Moderate", "Large"] } },
          { "label": "Effusion site marked", "min": 5, "match": { "f.marked": ["Yes"] } }
        ] },
        { "id": "famus-abdo", "label": "Abdominal-renal", "types": ["abdo"], "total": 40, "supervised": 10, "minDays": 122, "rules": [
          { "label": "Free fluid", "min": 10, "match": { "f.fluid": ["Small", "Moderate", "Large"] } },
          { "label": "Free fluid site marked", "min": 5, "match": { "f.marked": ["Yes"] } },
          { "label": "Hydronephrosis", "min": 5, "match": { "f.hydro": ["Mild", "Moderate", "Severe"] } },
          { "label": "Distended bladder", "min": 5, "match": { "f.bladder": ["Distended"] } }
        ] },
        { "id": "famus-dvt", "label": "DVT", "types": ["dvt"], "total": 10, "supervised": 5, "minDays": 30, "rules": [
          { "label": "DVT seen", "min": 1, "match": { "f.dvt": ["Yes"] } }
        ] },
        { "id": "famus-pva", "label": "Peripheral access", "types": ["pva"], "total": 5, "supervised": 3, "rules": [
          { "label": "On a simulation arm (1 at most)", "max": 1, "match": { "f.sim": ["Yes"] } }
        ] },
        { "id": "famus-lp", "label": "Ultrasound-assisted LP", "types": ["lp"], "total": 10, "supervised": 10, "minDays": 91, "rules": [
          { "label": "Successful LP", "min": 1, "match": { "f.lp": ["Successful"] } },
          { "label": "On a manikin (2 at most)", "max": 2, "match": { "f.manikin": ["Yes"] } }
        ] }
      ]
    },
    {
      "id": "fusic", "label": "FUSIC", "name": "Focused Ultrasound in Intensive Care (Intensive Care Society)",
      "source": "ICS FUSIC Heart training pack (2024) and FUSIC training details (2019) for the other modules. Logbook collection within 12 months, accreditation within 24 months.",
      "checked": "2026-10-04",
      "windowFrom": "firstScan", "windowDays": 365,
      "modules": [
        { "id": "fusic-heart", "label": "Heart", "types": ["cardiac"], "total": 50, "supervised": 10, "rules": [
          { "label": "Healthy volunteers (10% at most)", "max": 5, "match": { "setting": ["Healthy volunteer"] } }
        ] },
        { "id": "fusic-lung", "label": "Lung", "types": ["lung"], "total": 30, "supervised": 10, "rules": [
          { "label": "Normal scans (10 at most)", "max": 10, "match": { "overall": ["Normal"] } }
        ] },
        { "id": "fusic-abdo", "label": "Abdomen", "types": ["abdo"], "total": 25, "supervised": 10, "rules": [
          { "label": "Normal scans (15 at most)", "max": 15, "match": { "overall": ["Normal"] } }
        ] },
        { "id": "fusic-dvt", "label": "DVT", "types": ["dvt"], "total": 10, "supervised": 5, "rules": [
          { "label": "DVT seen", "min": 1, "match": { "f.dvt": ["Yes"] } }
        ] },
        { "id": "fusic-cvc", "label": "Vascular access: CVC", "types": ["cvc"], "total": 5, "supervised": 3 },
        { "id": "fusic-picc", "label": "Vascular access: PICC or midline", "types": ["picc"], "total": 3, "supervised": 1 },
        { "id": "fusic-pva", "label": "Vascular access: peripheral", "types": ["pva"], "total": 2, "supervised": 1 }
      ]
    },
    {
      "id": "general", "label": "General", "name": "General logbook",
      "source": "No external targets. Log any application and set your own targets.",
      "checked": "2026-10-04",
      "windowFrom": null,
      "modules": []
    }
  ],
  "_help_destinations": "Export destinations. Steps show after a learner builds a portfolio export. Keep wording general: Wavelength is not integrated with these portfolios.",
  "destinations": [
    {"id": "rcem", "label": "RCEM e-portfolio (risr/advance, formerly Kaizen)", "pathway": "rcem", "steps": ["Open your risr/advance (Kaizen) e-portfolio, ideally on a computer.", "Create or open the entry for your ultrasound evidence and attach this PDF.", "Paste the verification link into the entry, so your supervisor and ARCP panel check the summary online.", "Link the entry to the PoCUS parts of the curriculum. RCEM sign-off is by DOPS, so ask your supervisor to complete the DOPS assessments in the e-portfolio."]},
    {"id": "famus", "label": "FAMUS accreditation (Society for Acute Medicine)", "pathway": "famus", "steps": ["Keep this PDF with your countersigned report sheets.", "When the summary shows your targets met, ask your supervisor to complete the Assessment of Completion of Training (ACT).", "Send the signed ACT to the FAMUS administrator. Include this PDF and the verification link if they ask for your logbook.", "For reaccreditation every three years, export a fresh verified summary."]},
    {"id": "fusic", "label": "FUSIC accreditation (Intensive Care Society)", "pathway": "fusic", "steps": ["Share this PDF and the verification link with your FUSIC supervisor.", "Upload it wherever your FUSIC accreditation asks for logbook evidence.", "Once your targets are met, ask your supervisor to arrange the final assessment."]},
    {"id": "jrcptb", "label": "JRCPTB ePortfolio (physicians, including acute medicine)", "pathway": "famus", "steps": ["Open your JRCPTB ePortfolio.", "Upload this PDF to your personal library, or attach it to the entry it supports.", "Paste the verification link into the description.", "Link it to the curriculum capabilities it evidences and tell your educational supervisor where to find it."]},
    {"id": "appraisal", "label": "Appraisal and revalidation", "pathway": "", "steps": ["Upload this PDF to your appraisal portfolio as evidence of ultrasound practice.", "Paste the verification link into the supporting information.", "Use the reflective notes in the PDF for your reflection on practice."]},
    {"id": "other", "label": "Another portfolio or employer", "pathway": "", "steps": ["Attach this PDF to your portfolio or send it to the person who asked for it.", "Add the verification link, so they check the summary online."]}
  ]
}
