{
  "appId": "uk.co.thewavelength.app",
  "appName": "Wavelength",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A1526"
  },
  "android": {
    "backgroundColor": "#0A1526",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "css"
    }
  },
  "appendUserAgent": "WavelengthApp"
}
