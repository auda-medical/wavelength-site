{
  // Cloudflare Workers static site. The build writes the site to dist/, and wrangler serves it.
  // worker/index.js runs first for /volunteer/* (hidden volunteer sign-up), /admin/* (admin console) and /elearning/*, /api/* (Wavelength Academy).
  // Academy certificate emails use Zoho ZeptoMail: set the secret ZEPTOMAIL_TOKEN in Cloudflare.
  "name": "wavelength-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/volunteer", "/volunteer/*", "/admin", "/admin/*", "/elearning/*", "/api/*", "/media/*"]
  },
  "vars": { "NEWSLETTER_REQUIRED": "false", "MAIL_FROM": "academy@thewavelength.co.uk", "MAIL_FROM_NAME": "Wavelength Academy", "MAIL_REPLY_TO": "hello@thewavelength.co.uk", "ZEPTOMAIL_API": "https://cpaas.zoho.eu/v1.1/email", "IMAGE_SHARE": "true", "CLIP_SHARE": "true", "SUPERVISOR_APPLY": "true", "SUPERVISOR_APPROVAL_REQUIRED": "false", "SUPERVISOR_SEARCH": "false", "APP_MIN_VERSION": "", "APP_RECOMMENDED_VERSION": "" },
  "kv_namespaces": [{ "binding": "SHARED_IMAGES", "id": "2667a6ab05aa43b6b1d58189f81b56fa" }],
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "wavelength-volunteers", "database_id": "1d2a5805-b54f-4969-b0dc-8decaa5319cf" }
  ],
  "routes": [
    { "pattern": "thewavelength.co.uk", "custom_domain": true },
    { "pattern": "www.thewavelength.co.uk", "custom_domain": true }
  ],
  // Each cron runs exactly one job (worker/cron.js). Weekly newsletter: worker/newsletter.js sends at 7:30am UK time on
  // Tuesdays (06:30 UTC in summer, 07:30 UTC in winter). Daily supervisor job (dailyLifecycle): 05:15 UTC every day.
  "triggers": { "crons": ["30 6 * * TUE", "30 7 * * TUE", "15 5 * * *", "4,14,24,34,44,54 * * * *"] },
  "workers_dev": false,
  "preview_urls": false
}
