{
  // Cloudflare Workers static site. The build writes the site to dist/, and wrangler serves it.
  // worker/index.js runs first for /volunteer/* (hidden volunteer sign-up), /admin/* (admin console) and /elearning/*, /api/* (Wavelength Academy).
  // Academy certificate emails use Zoho ZeptoMail: set the secret ZEPTOMAIL_TOKEN in Cloudflare.
  "name": "wavelength-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/volunteer", "/volunteer/*", "/admin", "/admin/*", "/elearning/*", "/api/*", "/media/*", "/.well-known/*"]
  },
  "vars": { "NEWSLETTER_REQUIRED": "false", "MAIL_FROM": "academy@thewavelength.co.uk", "MAIL_FROM_NAME": "Wavelength Academy", "MAIL_REPLY_TO": "hello@thewavelength.co.uk", "ZEPTOMAIL_API": "https://cpaas.zoho.eu/v1.1/email", "IMAGE_SHARE": "true", "CLIP_SHARE": "true", "SUPERVISOR_APPLY": "true", "SUPERVISOR_APPROVAL_REQUIRED": "false", "SUPERVISOR_SEARCH": "false", "APP_MIN_VERSION": "", "APP_RECOMMENDED_VERSION": "", "PUSH_NOTIFY": "true" },
  // Rate limits for sign-in and supervisor search (DPIA Amendment 2 condition; owner, 20 Oct 2026): Cloudflare's rate-limiting
  // bindings, same limits as worker/ratelimit.js LIMITS (auth 10 a minute per IP, search 20 a minute per account and per IP).
  // Without them the D1 counter applies (it still does in local tests).
  "ratelimits": [
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_SEARCH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "kv_namespaces": [{ "binding": "SHARED_IMAGES", "id": "2667a6ab05aa43b6b1d58189f81b56fa" }],
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "wavelength-volunteers", "database_id": "1d2a5805-b54f-4969-b0dc-8decaa5319cf" }
  ],
  "routes": [
    { "pattern": "thewavelength.co.uk", "custom_domain": true },
    { "pattern": "www.thewavelength.co.uk", "custom_domain": true }
  ],
  // Each cron runs exactly one job (worker/cron.js). Weekly newsletter: worker/newsletter.js sends at 7:30am UK time on
  // Tuesdays (06:30 UTC in summer, 07:30 UTC in winter). Daily supervisor job (dailyLifecycle): 05:15 UTC every day.
  "triggers": { "crons": ["30 6 * * TUE", "30 7 * * TUE", "15 5 * * *", "4,14,24,34,44,54 * * * *"] },
  // 1.0.21: Workers Logs keep the one allowlisted line per app request (worker/log.js: route, status, ms, app version,
  // error class; no bodies, tokens or names). Invocation logs (which would include URLs) are off.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "workers_dev": false,
  "preview_urls": false
}
