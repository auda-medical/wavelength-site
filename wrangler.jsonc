{
  // Cloudflare Workers static site. The build writes the site to dist/, and wrangler serves it.
  // worker/index.js runs first for /volunteer/* (hidden volunteer sign-up) and /elearning/*, /api/* (Wavelength Academy).
  // Academy certificate emails use Zoho ZeptoMail: set the secret ZEPTOMAIL_TOKEN in Cloudflare.
  "name": "wavelength-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/volunteer", "/volunteer/*", "/elearning/*", "/api/*"]
  },
  "vars": { "MAIL_FROM": "academy@thewavelength.co.uk", "MAIL_FROM_NAME": "Wavelength Academy", "MAIL_REPLY_TO": "hello@thewavelength.co.uk", "ZEPTOMAIL_API": "https://api.zeptomail.eu/v1.1/email" },
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "wavelength-volunteers", "database_id": "1d2a5805-b54f-4969-b0dc-8decaa5319cf" }
  ],
  "routes": [
    { "pattern": "thewavelength.co.uk", "custom_domain": true },
    { "pattern": "www.thewavelength.co.uk", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
